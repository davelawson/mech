#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Keep machine-specific tool paths out of project.godot and the C# solution.
if ! command -v dotnet >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/share/mech-tools/dotnet/dotnet" ]]; then
    export DOTNET_ROOT="$HOME/.local/share/mech-tools/dotnet"
    export PATH="$DOTNET_ROOT:$PATH"
  else
    echo 'Install the .NET SDK specified by global.json, and put dotnet on PATH.' >&2
    exit 1
  fi
fi

# Engine-free unit tests need only dotnet. See docs/testing.md.
if [[ "${1:-}" == unit ]]; then shift; exec dotnet test --project Tests.Unit "$@"; fi

engine="${GODOT_BIN:-}"
if [[ -z "$engine" ]]; then
  for candidate in godot-mono godot4-mono godot godot4 \
    "$HOME/.local/share/mech-tools/godot/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64" \
    /Applications/Godot_mono.app/Contents/MacOS/Godot; do
    if command -v "$candidate" >/dev/null 2>&1; then
      case "$("$candidate" --version)" in
        4.7.2.stable.mono.*) engine="$candidate"; break ;;
      esac
    fi
  done
fi
if [[ -z "$engine" ]]; then
  echo 'Set GODOT_BIN to the Godot 4.7.2 .NET executable. See README.md.' >&2
  exit 1
fi
case "$("$engine" --version)" in
  4.7.2.stable.mono.*) ;;
  *) echo 'GODOT_BIN must point to Godot 4.7.2 .NET (mono), not the standard editor.' >&2; exit 1 ;;
esac

build() {
  mkdir -p Builds TestResults
  touch Builds/.gdignore TestResults/.gdignore
  dotnet build Mech.csproj --nologo
  "$engine" --headless --path . --editor --import
}
export_linux() {
  mkdir -p Builds/Linux
  "$engine" --headless --path . --export-release 'Linux x64' Builds/Linux/Mech.x86_64
  tar -czf Builds/Mech-linux-x64.tar.gz -C Builds/Linux .
}
export_macos() {
  mkdir -p Builds/macOS
  "$engine" --headless --path . --export-release 'macOS Universal' Builds/macOS/Mech.zip
}

export_windows() {
  if ! command -v zip >/dev/null 2>&1; then
    echo 'Install the zip command to package the Windows export.' >&2
    return 1
  fi
  mkdir -p Builds/Windows
  "$engine" --headless --path . --export-release 'Windows x64' Builds/Windows/Mech.exe
  local archive="$PWD/Builds/Mech-windows-x64.zip"
  # Recreate the archive so files removed from the export are not retained.
  rm -f "$archive"
  (cd Builds/Windows && zip -q -r "$archive" .)
}

# Test groups are named arguments; none runs the full suite. See docs/testing.md.
test_args() {
  local IFS=,
  if [[ $# -gt 0 ]]; then printf '%s\n' "--groups=$*"; fi
}

# The engine-free suites run only in Tests.Unit. A group lists the unit test classes covering its models;
# catalog and combat-sim are nothing but unit classes. Keep this table in step with docs/testing.md.
unit_classes() {
  case "$1" in
    map) echo Travel ;;
    roster) echo Roster ;;
    hangar) echo Hangar ;;
    missions) echo Missions Reputation ;;
    finance) echo Campaign ;;
    catalog) echo Catalog ;;
    combat-sim) echo Combat 'Terrain*' ;;
    multiplayer) echo 'Network*' ;;
  esac
}
unit_only() { [[ "$1" == catalog || "$1" == combat-sim ]]; }
# The slowest groups start first so the parallel run finishes soonest.
slow_groups='combat-ui multiplayer mech-visuals menu'

# One job of a parallel test run: "unit" or a Godot group. Prints a single result line; the full output is in its log.
run_job() {
  local job="$1" log="TestResults/test-logs/$1.log" start=$SECONDS status=0
  if [[ "$job" == unit ]]; then
    # shellcheck disable=SC2086 # the filter list is split on purpose
    dotnet test --project Tests.Unit --no-build $MECH_UNIT_FILTERS >"$log" 2>&1 || status=$?
  else
    "$engine" --headless --path . --scene res://Tests/SmokeTests.tscn -- "--groups=$job" >"$log" 2>&1 || status=$?
  fi
  local seconds=$((SECONDS - start))
  if [[ $status -eq 0 ]]; then
    if [[ "$job" == unit ]]; then printf '  unit: %s (%ss)\n' "$(grep -Eo 'succeeded: [0-9]+' "$log" | tail -1)" "$seconds"
    else printf '  %s (%ss)\n' "$(grep -E "^  $job: " "$log" | sed 's/^  //')" "$seconds"; fi
  else
    printf '  %s: FAILED after %ss, see %s\n' "$job" "$seconds" "$log"
    grep -E 'FAIL|failed|error' "$log" | grep -v '0 Error' | head -5 | sed 's/^/      /' || true
  fi
  return $status
}

# Runs the named groups, or every group in the full run, as parallel processes alongside their unit classes.
run_tests() {
  local groups=() godot=() filters='' jobs=() group class
  if [[ $# -eq 0 ]]; then
    # Group names alone on a line; subsets (marked "(subset…)") and Godot's banner are skipped.
    while IFS= read -r group; do [[ "$group" =~ ^[a-z-]+$ ]] && groups+=("$group"); done \
      < <("$engine" --headless --path . --scene res://Tests/SmokeTests.tscn -- --list-groups 2>/dev/null | tr -d '\r')
    groups+=(catalog combat-sim)
  else
    groups=("$@")
  fi
  for group in "${groups[@]}"; do
    unit_only "$group" || godot+=("$group")
    for class in $(unit_classes "$group"); do filters+=" --filter-class Mech.Tests.Unit.$class"; done
  done
  # With no groups named, the whole unit suite runs rather than the classes the groups list.
  [[ $# -eq 0 ]] && filters=''
  if [[ $# -eq 0 || -n "$filters" ]]; then jobs+=(unit); fi
  for group in $slow_groups; do
    for named in "${godot[@]}"; do [[ "$named" == "$group" ]] && jobs+=("$group"); done
  done
  for group in "${godot[@]}"; do [[ " $slow_groups " == *" $group "* ]] || jobs+=("$group"); done
  rm -rf TestResults/test-logs; mkdir -p TestResults/test-logs
  if [[ " ${jobs[*]} " == *' unit '* ]]; then dotnet build Tests.Unit --nologo -v q >TestResults/test-logs/unit-build.log 2>&1 \
    || { cat TestResults/test-logs/unit-build.log; return 1; }; fi
  local start=$SECONDS status=0
  printf '%s\n' "${jobs[@]}" | MECH_UNIT_FILTERS="$filters" GODOT_BIN="$engine" xargs -P "${MECH_TEST_JOBS:-4}" -n 1 "$PWD/scripts/mech" _job || status=$?
  if [[ $status -eq 0 ]]; then echo "PASS: ${jobs[*]} in $((SECONDS - start))s"; else echo "FAIL: logs in TestResults/test-logs/"; return 1; fi
}

command="${1:-run}"
[[ $# -gt 0 ]] && shift
case "$command" in
  build) build ;;
  run) build; exec "$engine" --path . ;;
  editor) exec "$engine" --editor --path . ;;
  test)
    if [[ "${1:-}" == --list ]]; then
      build; "$engine" --headless --path . --scene res://Tests/SmokeTests.tscn -- --list-groups
      echo 'catalog (unit tests only)'; echo 'combat-sim (unit tests only)'; exit 0
    fi
    build; run_tests "$@" ;;
  _job) run_job "$1" ;;
  capture) build; exec "$engine" --path . --scene res://Tests/SmokeTests.tscn -- --screenshots $(test_args "$@") ;;
  export-linux) build; export_linux ;;
  export-macos) build; export_macos ;;
  export-windows) build; export_windows ;;
  exports) build; export_linux; export_macos; export_windows ;;
  *) echo "Usage: $0 {run|editor|build|unit|test [--list|group...]|capture [group...]|export-linux|export-macos|export-windows|exports}" >&2; exit 2 ;;
esac
